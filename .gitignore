# Java 教学演示项目（经典 src/ 布局 + 根目录 Maven 测试）

# 编译与打包产物（仓库内不再保留第三方 JAR）
*.class
*.jar

# 编译输出目录（含 README 中的 javac -d encryption/bin）
encryption/bin/
bin/
out/
build/

# Maven 构建输出（mvn test / mvn package）
target/

# IDE
.idea/
*.iml
.classpath
.project
.settings/

# 操作系统杂文件
.DS_Store
Thumbs.db

# 日志（可选）
*.log
